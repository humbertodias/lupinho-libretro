# syntax=docker/dockerfile:1
FROM debian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    make gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 libz-mingw-w64-dev \
    cmake ninja-build python3 git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY lupinho/src/music/fetch_furnace.sh /tmp/fetch_furnace.sh
RUN sh /tmp/fetch_furnace.sh /furnace
COPY Makefile ./
COPY src/ src/
COPY lupinho/src/ lupinho/src/
# The image has MinGW's archiver, not binutils' ar. Furnace objects are packed with ar.
RUN set -eu; \
    ln -sfn "$(command -v x86_64-w64-mingw32-ar)" /usr/local/bin/ar; \
    ln -sfn "$(command -v x86_64-w64-mingw32-ranlib)" /usr/local/bin/ranlib; \
    make -j"$(nproc)" libretro-win FURNACE_SRC=/furnace

FROM scratch
COPY --from=build /src/dist/ /
